[Unit]
Description=Automation server (automation.akashmahor.me)
After=network-online.target
Wants=network-online.target

[Service]
User=akash
EnvironmentFile=/etc/automation/automation.env
ExecStart=/home/akash/automation/bin/automation-server
Restart=always
RestartSec=3
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=true
# Writable /var/lib/automation for the user/token database (everything else stays read-only).
StateDirectory=automation
StateDirectoryMode=0700
Environment=AUTOMATION_DB=/var/lib/automation/automation.db

[Install]
WantedBy=multi-user.target
