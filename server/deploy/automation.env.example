# Copy to /etc/automation/automation.env on the server (chmod 600). Never commit the real file.
# After editing: sudo systemctl restart automation

# ---- basics ----
AUTOMATION_ORIGIN=https://automation.example.com
AUTOMATION_BIND=127.0.0.1:3000
# Must equal DEVICE_TOKEN in firmware/LoRa_esp32_master/secrets.h. Generate: openssl rand -hex 32
AUTOMATION_DEVICE_TOKEN=replace-with-a-long-random-hex-token
# SQLite file for users and tokens. The systemd unit sets /var/lib/automation/automation.db.
#AUTOMATION_DB=/var/lib/automation/automation.db

# ---- who may sign in (comma-separated emails, case-insensitive) ----
# Admins: everything, including scan, curtain "learn travel", fan re-home and the master LED.
AUTOMATION_ADMINS=you@example.com
# Members: lights, fans, curtains (open/close/stop/position), dimmers, refresh.
AUTOMATION_MEMBERS=
# Apple users who choose "Hide My Email" sign in with an @privaterelay.appleid.com address;
# put that address here, or ask them to choose "Share My Email".

# ---- emergency password login (admin). Leave empty to turn it off. ----
AUTOMATION_PASSWORD=change-me

# ---- Google (console.cloud.google.com > APIs & Services > Credentials) ----
# "Web application" OAuth client. Authorized redirect URI: <AUTOMATION_ORIGIN>/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Mobile app OAuth client IDs (iOS and Android), comma-separated. Android apps should also pass
# GOOGLE_CLIENT_ID as serverClientId, which is accepted automatically.
GOOGLE_APP_CLIENT_IDS=

# ---- Apple (developer.apple.com > Certificates, Identifiers & Profiles) ----
# Services ID for web sign-in. Return URL: <AUTOMATION_ORIGIN>/auth/apple/callback
APPLE_SERVICES_ID=
# Bundle IDs of the iOS app(s) using native Sign in with Apple, comma-separated.
APPLE_BUNDLE_IDS=
